{
  "name": "smarteasybim-cde",
  "productName": "SmartEasyBIM CDE",
  "version": "0.1.0",
  "description": "CDE (Ambiente Comum de Dados, ISO 19650) local: servidor na rede do escritório",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite",
    "server": "node server/standalone.js",
    "start": "npm run build:web && electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "npm run build:web && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.smarteasybim.cde",
    "productName": "SmartEasyBIM CDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "console.html",
      "server/**/*",
      "web-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "SmartEasyBIM-CDE-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "asar": false
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.12.0",
    "web-ifc": "^0.0.72"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.170.0",
    "vite": "^5.4.11"
  }
}
