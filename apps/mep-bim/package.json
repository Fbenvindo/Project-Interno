{
  "name": "mep-bim-desktop",
  "productName": "MEP BIM",
  "version": "0.1.0",
  "description": "Aplicativo desktop para projetos MEP em BIM (IFC): visualização, quantitativos, interferências e dimensionamento.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "electron-vite dev",
    "predev:web": "node scripts/prepare-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sample": "node scripts/generate-sample-ifc.mjs && node scripts/prepare-assets.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "web-ifc": "0.0.72"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.projetointerno.mepbim",
    "productName": "MEP BIM",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
