{
  "name": "mep-bim-desktop",
  "productName": "SmartEasyBIM",
  "version": "0.1.0",
  "description": "Aplicativo desktop para projetos MEP em BIM (IFC): visualização, quantitativos, interferências e dimensionamento.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "electron-vite dev",
    "predev:web": "node scripts/prepare-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sample": "node scripts/generate-sample-ifc.mjs && node scripts/prepare-assets.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "web-ifc": "0.0.72"
  },
  "build": {
    "appId": "com.projetointerno.mepbim",
    "productName": "SmartEasyBIM",
    "copyright": "Project Interno",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "ifc",
        "name": "Modelo IFC",
        "description": "Modelo BIM (IFC)",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SmartEasyBIM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartEasyBIM"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  },
  "author": {
    "name": "Project Interno"
  }
}
